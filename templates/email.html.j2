<!doctype html>
<html>
<body style="font-family: -apple-system, Segoe UI, Roboto, sans-serif; background: #f6f7fb; padding: 24px 0; margin: 0;">
  <table align="center" width="560" cellpadding="0" cellspacing="0" style="background: #ffffff; border: 1px solid #e6e9f0; border-radius: 10px; padding: 28px;">
    <tr><td>
      <p style="font-size: 11px; letter-spacing: 0.14em; color: #7aa2f7; text-transform: uppercase; margin: 0 0 8px;">Daily Buy Candidates · {{ as_of.strftime('%d %b %Y') }}</p>
      <h1 style="font-size: 20px; color: #0a0e1a; margin: 0 0 18px;">{{ hero_headline }}</h1>

      <p style="font-size: 14px; color: #4b5266; line-height: 1.6; margin: 0 0 22px;">{{ macro_blurb }}</p>

      <p style="font-size: 12px; color: #8b93a7; text-transform: uppercase; letter-spacing: 0.1em; margin: 0 0 10px;">Top 3 today</p>

      {% for p in top3 %}
      <table width="100%" cellpadding="0" cellspacing="0" style="border-top: 1px solid #e6e9f0; padding: 14px 0;">
        <tr>
          <td>
            <p style="margin: 0; font-family: 'JetBrains Mono', monospace; font-size: 15px; color: #0a0e1a;">
              <strong>{{ p.ticker }}</strong> · <span style="color: #8b93a7;">{{ p.sector }}</span> · <span style="color: #4ade80;">{{ p.composite }}</span>
            </p>
            <p style="margin: 6px 0 0; font-size: 13px; color: #4b5266; line-height: 1.55;">{{ p.first_sentence }}</p>
          </td>
        </tr>
      </table>
      {% endfor %}

      <p style="margin: 24px 0 0;">
        <a href="{{ dashboard_url }}" style="display: inline-block; background: #0a0e1a; color: #ffffff; padding: 10px 18px; border-radius: 6px; text-decoration: none; font-size: 14px;">Open the full dashboard &rarr;</a>
      </p>

      <p style="font-size: 11px; color: #8b93a7; margin: 28px 0 0; line-height: 1.5;">
        <strong style="color: #fbbf24;">Not financial advice.</strong>
        Information only. Verify before acting.
      </p>
    </td></tr>
  </table>
</body>
</html>
